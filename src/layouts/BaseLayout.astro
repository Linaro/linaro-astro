---
import BaseHead from "@/components/head/BaseHead.astro";
import NavBar from "@/components/nav/NavBar.astro";
import Footer from "@/components/footer/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
}

const { title, description, type = "website", image } = Astro.props;
---

<html lang="en">
  <BaseHead
    title={title + " | Linaro"}
    description={description}
    image={image}
    type={type}
  />
  <body class="min-h-screen flex flex-col text-white">
    <NavBar />
    <slot />
    <Footer />
    <script>
      const animatedElements = document.querySelectorAll("[data-animate]");

      const observer = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!(entry.target instanceof HTMLElement)) return;
            const animatedClass = entry.target.dataset["animate"] as string;
            if (entry.isIntersecting) {
              entry.target.classList.add(animatedClass);
              entry.target.classList.remove("invisible");
              observer.unobserve(entry.target);
            } else {
              entry.target.classList.remove(animatedClass);
            }
          });
        },
        {
          rootMargin: "-300px 0px -300px 0px",
        },
      );

      animatedElements.forEach((el) => {
        observer.observe(el);
      });
    </script>
    <script>
      declare global {
        interface Window {
          dataLayer: Record<string, any>[];
        }
      }

      interface CtaDetail {
        id: string;
        text: string;
        destination: string;
        outbound: boolean;
        page: string;
      }

      const CTA_PANEL_ID = "cta-debug-panel";

      function ctaDebugEnabled(): boolean {
        return new URLSearchParams(window.location.search).has("ctadebug");
      }

      function ctaDebugPanel(): HTMLElement {
        const existing = document.getElementById(CTA_PANEL_ID);
        if (existing) return existing;

        const panel = document.createElement("div");
        panel.id = CTA_PANEL_ID;
        panel.innerHTML =
          '<strong style="display:block;margin-bottom:6px;color:#FFCE00">' +
          "CTA clicks captured</strong>" +
          '<ol style="margin:0;padding-left:18px"></ol>';
        Object.assign(panel.style, {
          position: "fixed",
          right: "12px",
          bottom: "12px",
          zIndex: "9999",
          maxWidth: "24rem",
          maxHeight: "45vh",
          overflowY: "auto",
          padding: "10px 12px",
          borderRadius: "10px",
          border: "1px solid #6715E8",
          background: "rgba(0,0,0,0.9)",
          color: "#fff",
          font: "12px/1.5 ui-monospace, monospace",
        });
        document.body.appendChild(panel);
        return panel;
      }

      function ctaDebugRecord(cta: CtaDetail): void {
        const list = ctaDebugPanel().querySelector("ol");
        if (!list) return;
        const item = document.createElement("li");
        item.style.marginBottom = "6px";
        item.textContent = cta.id;
        const dest = document.createElement("div");
        dest.style.opacity = "0.65";
        dest.textContent = (cta.outbound ? "outbound " : "") + cta.destination;
        item.appendChild(dest);
        list.appendChild(item);
      }

      function isOutbound(destination: string): boolean {
        try {
          return new URL(destination, window.location.href).host !== window.location.host;
        } catch {
          return false;
        }
      }

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const trigger = target.closest("[data-cta-id]");
        if (!(trigger instanceof HTMLElement)) return;

        const id = trigger.dataset.ctaId;
        if (!id) return;

        const href = trigger instanceof HTMLAnchorElement ? trigger.href : "";
        const destination = href || "form:" + id;

        const cta: CtaDetail = {
          id,
          text: (trigger.textContent || "").trim().replace(/\s+/g, " "),
          destination,
          outbound: href ? isOutbound(href) : false,
          page: window.location.pathname,
        };

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "cta_click", cta });

        if (ctaDebugEnabled()) ctaDebugRecord(cta);
      });

      ["DOMContentLoaded", "astro:after-swap"].forEach((event) => {
        document.addEventListener(event, () => {
          if (ctaDebugEnabled()) ctaDebugPanel();
        });
      });
    </script>
    <script>
      declare global {
        interface Window {
          dataLayer: Record<string, any>[];
        }
      }
      ["DOMContentLoaded", "astro:after-swap"].forEach((event) => {
        document.addEventListener(event, addListeners);
      });

      import { FriendlyCaptchaSDK } from "@friendlycaptcha/sdk";
      import { actions } from "astro:actions";

      // 1. Declare at the top of the script scope
      let captchaWidget: any = null;

      // Initialize the widget
      const mount = document.querySelector("#friendly-captcha-widget");
      if (mount) {
        captchaWidget = new FriendlyCaptchaSDK().createWidget({
          element: mount,
          sitekey: import.meta.env.PUBLIC_FRIENDLY_CAPTCHA_SITEKEY,
        });
      }

      function addListeners() {
        const forms = document.querySelectorAll(
          "[data-contact-form]",
        ) as NodeListOf<HTMLFormElement>;

        forms.forEach((form) => {
          form.addEventListener("submit", (event) => onSubmit(event, form));
        });

        const newsletterForm = document.querySelector(
          "#insight-form",
        ) as HTMLFormElement | null;

        if (newsletterForm) {
          const mailchimpUrl =
            "https://linaro.us3.list-manage.com/subscribe/post?u=14baaae786342d0d405ee59c2&id=bcfa4abc8f";

          newsletterForm.addEventListener("submit", (event) => {
            event.preventDefault();
            const button = newsletterForm.querySelector("#contact-submit");
            const loader = newsletterForm.querySelector("#contact-submitting");
            button?.classList.add("hidden");
            loader?.classList.remove("hidden");
            const formName =
              (
                newsletterForm.querySelector(
                  "input[name='formName']",
                ) as HTMLInputElement
              )?.value || "unknown_form";

            if (!window.dataLayer) {
              window.dataLayer = [];
            }

            if (typeof window.dataLayer.push === "function") {
              window.dataLayer.push({
                formName: formName,
                event: "form_submission",
              });
            }
            const tempForm = document.createElement("form");
            tempForm.action = mailchimpUrl;
            tempForm.method = "POST";
            tempForm.style.display = "none";

            const inputs = newsletterForm.querySelectorAll(
              "input, select, textarea",
            );
            inputs.forEach((input) => {
              const cloned = input.cloneNode(true) as HTMLInputElement;
              tempForm.appendChild(cloned);
            });

            document.body.appendChild(tempForm);
            setTimeout(() => {
              tempForm.submit();
              loader?.classList.add("hidden");
              button?.classList.remove("hidden");
            }, 5000);
          });
        }
      }

      async function handleWebinarResponse(
        form: HTMLFormElement,
        feedbackText: HTMLParagraphElement,
      ) {
        const webinarDataId =
          (
            form.querySelector(
              "input[name='webinarDataId']",
            ) as HTMLInputElement
          )?.value ?? "unknown_webinar";

        try {
          const res = await fetch(`/api/webinar-data/${webinarDataId}.json`);
          if (!res.ok) {
            throw new Error("Failed to load webinar data");
          }

          const { passcode, url, type } = await res.json();

          if (type === "video") {
            // Close the modal dialog and hide its trigger button
            const dialog = form.closest("dialog");
            if (dialog) {
              dialog.close();
              const triggerButton = document.getElementById(`${dialog.id}-trigger`);
              if (triggerButton) (triggerButton as HTMLElement).style.display = "none";
            }

            // Populate and reveal the on-page video player
            const videoContainer = document.getElementById("webinar-video-container");
            const videoContent = document.getElementById("webinar-video-content");
            if (videoContainer && videoContent) {
              videoContent.innerHTML = `
                <p class="text-lg mb-4">Thank you! Enjoy the recording.</p>
                <video
                  src="${url}"
                  controls
                  controlslist="nodownload"
                  class="w-full rounded-lg"
                >
                  Your browser does not support video playback.
                </video>
              `;
              videoContainer.classList.remove("hidden");
              videoContainer.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          } else {
            feedbackText.innerHTML = `
      <div class="space-y-4 text-center">
        <p class="text-base">
          Thank you! Please use the link below to access the webinar.
        </p>

        ${
          passcode
            ? `<div class="text-lg font-semibold text-blue-600">
          Passcode:
          <div class="text-2xl font-bold text-blue-700">${passcode}</div>
        </div>`
            : ""
        }

        <div>
          <a
            href="${url}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-xl text-blue-700 font-semibold underline"
          >
            Link to webinar recording
          </a>
        </div>
      </div>
    `;
          }
        } catch (err) {
          console.error("Webinar fetch error:", err);
          feedbackText.innerHTML = `
      <p class="text-red-600">
        Sorry, something went wrong loading the webinar information.
      </p>
    `;
        }
      }

      async function handleWhitepaperResponse(
        form: HTMLFormElement,
        feedbackText: HTMLParagraphElement,
      ) {
        const whitepaperId =
          (form.querySelector("input[name='whitepaperId']") as HTMLInputElement)
            ?.value ?? "unknown_whitepaper";

        try {
          const res = await fetch(`/api/whitepaper-data/${whitepaperId}.json`);
          if (!res.ok) {
            throw new Error("Failed to load whitepaper data");
          }

          const { url } = await res.json();

          feedbackText.innerHTML = `
      <div class="space-y-4 text-center">
        <p class="text-base">
          Thank you! Your download should start automatically.
        </p>

        <div>
          <a
            href="${url}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-xl text-blue-700 font-semibold underline"
          >
            Download Whitepaper
          </a>
        </div>
      </div>
    `;

          // Trigger auto-download
          window.location.href = url;
        } catch (err) {
          console.error("Whitepaper fetch error:", err);
          feedbackText.innerHTML = `
      <p class="text-red-600">
        Sorry, something went wrong loading the whitepaper.
      </p>
    `;
        }
      }

      async function onSubmit(e: SubmitEvent, form: HTMLFormElement) {
        e.preventDefault();

        const feedback = form.parentElement!.querySelector("#contact-feedback");
        const feedbackText = form.parentElement!.querySelector(
          "#contact-feedback-text",
        ) as HTMLParagraphElement;

        const button = form.querySelector("#contact-submit");
        const loader = form.querySelector("#contact-submitting");

        if (!e.target) return;

        const data = new FormData(e.target as HTMLFormElement);
        const payload: Record<string, any> = {};

        const formName =
          (form.querySelector("input[name='formName']") as HTMLInputElement)
            ?.value ?? "unknown_form";

        const captchaSolution = captchaWidget?.response;

        console.log(captchaSolution, captchaWidget);

        if (!captchaSolution) {
          feedback!.classList.remove("hidden");
          feedbackText!.innerText =
            "Please complete the captcha before submitting.";
          button?.classList.remove("hidden");
          loader?.classList.add("hidden");
          return;
        }

        payload["frc-captcha-response"] = captchaSolution;

        // -----------------------
        // Telephone validation
        // -----------------------
        // Message key is now standard 'message'
        const messageKey = "message";
        const phoneInput = form.querySelector(
          'input[name="phone"]',
        ) as HTMLInputElement;

        const phoneNumber = phoneInput?.value || null;
        const phoneRegex = /^[+]?[0-9\s\-()]{6,25}$/;

        if (phoneNumber && !phoneRegex.test(phoneNumber)) {
          feedback?.classList.remove("hidden");
          feedbackText!.innerText = "Please enter a valid telephone number.";
          phoneInput?.classList.add("border-4", "border-red-500");
          return;
        }

        phoneInput?.classList.remove("border-4", "border-red-500");

        // -----------------------
        // Build payload
        // -----------------------
        let message = data.get(messageKey) as string | null;

        data.forEach((value, key) => {
          // Allow all fields except internal ones or captcha response which is handled separately
          if (key !== "frc-captcha-response") {
            payload[key] = value;
          }
        });

        // Use standard 'email' field or fallback if needed (though we should enforce standard names now)
        if (!payload.email) {
          console.error("Email missing from payload");
          return;
        }

        delete payload.agreed;

        // Split the single "Full Name" field into first/last name so the
        // Pipeline CRM integration continues to receive them separately.
        if (payload.fullName) {
          const nameParts = String(payload.fullName).trim().split(/\s+/);
          payload.firstName = nameParts.shift() ?? "";
          payload.lastName = nameParts.join(" ");
          delete payload.fullName;
        }

        console.log(payload);

        // -----------------------
        // Analytics
        // -----------------------
        window.dataLayer ??= [];
        window.dataLayer.push({
          event: "form_submission",
          formName,
        });

        // -----------------------
        // UI state
        // -----------------------
        button?.classList.add("hidden");
        loader?.classList.remove("hidden");

        try {
          // Using Astro Actions
          console.log("Submitting to Action...");
          const { data, error } = await actions.contact(payload);
          console.log("Action Response:", data, error);

          if (error) {
            if (error.code === "BAD_REQUEST") {
              captchaWidget?.reset();
              throw new Error(error.message);
            }
            throw new Error(error.message || "Server error");
          }

          const result = data;
          if (!result?.success) {
            throw new Error("Submission failed");
          }

          // -----------------------
          // Success UI
          // -----------------------
          form.classList.add("hidden");
          feedback?.classList.remove("hidden");

          if (formName === "webinar_contact") {
            await handleWebinarResponse(form, feedbackText);
          } else if (formName === "whitepaper_contact") {
            await handleWhitepaperResponse(form, feedbackText);
          } else if (!error && data?.success) {
            // Redirect the user to the thank you page
            window.location.href = "/contact/thank-you";
          } else {
            feedbackText!.innerText = result.message;
          }
        } catch (err) {
          console.error("Form submission error:", err);
          feedback?.classList.remove("hidden");
          feedbackText!.innerText =
            "There was an error during submission. Please try again later.";
          button?.classList.remove("hidden");
        } finally {
          loader?.classList.add("hidden");
        }
      }
    </script>
  </body>
</html>
