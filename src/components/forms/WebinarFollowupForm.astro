---
// Standalone follow-up form for webinar attendees. Reuses the same
// data-contact-form / Friendly Captcha / Pipeline CRM submission pattern
// wired up in BaseLayout.astro (see `onSubmit`), rather than introducing a
// new submission mechanism.
const { form_id, formName } = Astro.props;

const howCanWeHelpOptions = [
  "Follow-Up Technical Question for Behan",
  "Inquiring about Linaro Engineering Services",
  "Assistance with Arm CCA",
  "Other",
];

const hearAboutOptions = ["LinkedIn", "Meta", "Email", "Referral", "Other"];
---

<div class="bg-black lg:min-w-[40rem] max-w-xl rounded-3xl px-8 py-8 w-full mx-auto">
  <form
    class="flex flex-col items-start gap-6 w-full"
    id="contact-form"
    data-contact-form={form_id}
    method="get"
  >
    <input type="hidden" name="form_id" value={form_id} />
    <input type="hidden" name="formName" value={formName} />

    <div class="flex gap-4 w-full">
      <div class="flex-1">
        <label for="firstName" class="sr-only">First Name</label>
        <input
          type="text"
          name="firstName"
          id="firstName"
          required
          placeholder="First Name"
          class="text-black pl-2 h-12 w-full"
        />
      </div>
      <div class="flex-1">
        <label for="lastName" class="sr-only">Last Name</label>
        <input
          type="text"
          name="lastName"
          id="lastName"
          required
          placeholder="Last Name"
          class="text-black pl-2 h-12 w-full"
        />
      </div>
    </div>

    <label for="company" class="sr-only">Company</label>
    <input
      type="text"
      name="company"
      id="company"
      required
      placeholder="Company"
      class="text-black pl-2 h-12 w-full"
    />

    <label for="email" class="sr-only">Work Email</label>
    <input
      type="email"
      name="email"
      id="email"
      required
      placeholder="Work Email"
      class="text-black pl-2 h-12 w-full"
    />

    <div class="w-full">
      <label for="howCanWeHelp" class="block text-white mb-2"
        >How can we help you?</label
      >
      <select
        name="howCanWeHelp"
        id="howCanWeHelp"
        required
        class="text-black pl-2 h-12 w-full"
      >
        <option value="" disabled selected>Select an option</option>
        {
          howCanWeHelpOptions.map((option) => (
            <option value={option}>{option}</option>
          ))
        }
      </select>
      <div id="howCanWeHelpOtherWrapper" class="hidden mt-3">
        <label for="howCanWeHelpOther" class="sr-only"
          >Please provide more detail</label
        >
        <input
          type="text"
          name="howCanWeHelpOther"
          id="howCanWeHelpOther"
          placeholder="Please provide more detail"
          class="text-black pl-2 h-12 w-full"
        />
      </div>
    </div>

    <div class="w-full">
      <label for="hearAboutWebinar" class="block text-white mb-2"
        >Where did you hear about this webinar?</label
      >
      <select
        name="hearAboutWebinar"
        id="hearAboutWebinar"
        required
        class="text-black pl-2 h-12 w-full"
      >
        <option value="" disabled selected>Select an option</option>
        {
          hearAboutOptions.map((option) => (
            <option value={option}>{option}</option>
          ))
        }
      </select>
    </div>

    <div id="friendly-captcha-widget" class="frc-captcha"></div>

    <div class="flex items-start gap-2">
      <input
        type="checkbox"
        name="newsletter"
        id="newsletter"
        value="Yes"
        class="mt-1"
      />
      <label for="newsletter" class="text-white"
        >Subscribe me to Linaro's email newsletter</label
      >
    </div>

    <div class="flex items-start gap-2">
      <input type="checkbox" name="agreed" id="agreed" required class="mt-1" />
      <label for="agreed" class="text-white"
        >I've read and agreed to Linaro's <a
          href="/legal#privacy"
          class="text-white underline">Privacy Policy</a
        ></label
      >
    </div>

    <div class="flex gap-8">
      <button type="submit" class="linaro-gradient-button" id="contact-submit"
        >Submit</button
      >

      <button
        type="button"
        class="linaro-gradient-button flex justify-start items-center gap-2 hidden"
        id="contact-submitting"
      >
        <svg
          aria-hidden="true"
          class="w-4 h-4 text-gray-200 animate-spin fill-white"
          viewBox="0 0 100 101"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z"
            fill="currentColor"></path>
          <path
            d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z"
            fill="currentFill"></path>
        </svg>
        Submitting</button
      >
    </div>
  </form>
  <div id="contact-feedback" class="hidden">
    <p id="contact-feedback-text" class="text-white"></p>
  </div>
</div>

<script>
  // Show the free-text field only when "Other" is selected, and require it
  // in that case so Pipeline CRM always gets a usable value.
  function toggleHowCanWeHelpOther() {
    const select = document.getElementById(
      "howCanWeHelp",
    ) as HTMLSelectElement | null;
    const wrapper = document.getElementById("howCanWeHelpOtherWrapper");
    const otherInput = document.getElementById(
      "howCanWeHelpOther",
    ) as HTMLInputElement | null;
    if (!select || !wrapper || !otherInput) return;

    const isOther = select.value === "Other";
    wrapper.classList.toggle("hidden", !isOther);
    otherInput.required = isOther;
  }

  function addListeners() {
    const select = document.getElementById("howCanWeHelp");
    select?.addEventListener("change", toggleHowCanWeHelpOther);
    toggleHowCanWeHelpOther();
  }

  ["DOMContentLoaded", "astro:after-swap"].forEach((event) => {
    document.addEventListener(event, addListeners);
  });
</script>
